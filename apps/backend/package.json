{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express + Drizzle backend for ai-base-app",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main/server.js",
    "dev": "tsx watch --env-file-if-exists=.env src/main/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run __tests__/unit",
    "test:integration": "vitest run __tests__/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "k6:smoke": "docker run --rm -i --network host grafana/k6 run - < ../../scripts/k6/smoke.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "drizzle-orm": "^0.44.5",
    "express": "^5.1.0",
    "nodemailer": "^8.0.7",
    "pg": "^8.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.55.0",
    "@testcontainers/postgresql": "^11.5.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.33.0",
    "playwright": "^1.55.0",
    "supertest": "^7.1.4",
    "testcontainers": "^11.5.1",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
