{
  "name": "ai-base-app",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack starter template: Node.js + TypeScript + Express + Drizzle + React + Vite",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend run dev\" \"pnpm --filter frontend run dev\" --names \"backend,frontend\" --prefix-colors \"blue,green\"",
    "build": "pnpm -r run build",
    "start": "pnpm --filter backend run start",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter backend run test",
    "test:unit": "pnpm --filter backend run test:unit",
    "test:integration": "pnpm --filter backend run test:integration",
    "test:e2e": "pnpm --filter backend run test:e2e",
    "db:up": "docker compose -f apps/backend/docker-compose.yml up -d",
    "db:down": "docker compose -f apps/backend/docker-compose.yml down",
    "db:push": "pnpm --filter backend run db:push",
    "db:migrate": "pnpm --filter backend run db:migrate",
    "db:generate": "pnpm --filter backend run db:generate",
    "rename": "node scripts/rename.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "design-tokens:build": "node apps/frontend/design-tokens/build-normalized.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
